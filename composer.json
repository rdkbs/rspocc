{
    "$schema": "https://getcomposer.org/schema.json",
    "authors": [
        {
            "homepage": "https://github.com/rdkbs",
            "name": "Research and Development Koperasi Belayan Sejahtera"
        }
    ],
    "name": "rdkbs/rspocc",
    "type": "project",
    "description": "RSPO Credit Calculator.",
    "keywords": [
        "RSPO"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/framework": "^13.40",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1"
    },
    "require-dev": {
        "andreapollastri/checkpoint": "^1.2",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.14",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.3",
        "pestphp/pest-plugin-rector": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint:fix": [
            "pint --parallel",
            "rector",
            "bunx vp check --fix"
        ],
        "lint:check": [
            "rector --dry-run",
            "pint --parallel --test",
            "bunx vp check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "bun run test:calculator",
            "@php artisan checkpoint:scan",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "cooldown": {
                "period": "7 days"
            }
        }
    },
    "minimum-stability": "stable"
}
